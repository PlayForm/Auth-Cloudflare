{
    "name": "@playform/auth-cloudflare",
    "version": "0.0.7",
    "private": true,
    "description": "Auth Cloudflare Workers AI authentication provider plugin for Hermes Agent",
    "license": "CC0-1.0",
    "repository": "PlayForm/Auth-Cloudflare",
    "scripts": {
        "Format": "bash Maintain/Format.sh",
        "Format:LineEndings": "bash Maintain/Format.sh dos2unix",
        "Format:Shell": "bash Maintain/Format.sh shell",
        "Format:Prettier": "bash Maintain/Format.sh prettier",
        "Format:Rust": "bash Maintain/Format.sh rust",
        "FormatCheck": "prettier --check .",
        "prepare": "git config core.hooksPath .githooks"
    },
    "devDependencies": {
        "prettier": "3.9.8",
        "prettier-plugin-sh": "0.19.0"
    },
    "engines": {
        "node": ">=20",
        "pnpm": ">=9"
    },
    "packageManager": "pnpm@11.18.0"
}
