# plugins/auth-hermes-cloudflare is a separate submodule that formats
# itself - re-include exactly that one README (gitignore semantics: the
# directory exclusions above must be undone first, then everything under
# plugins/auth-hermes-cloudflare re-excluded, then the README re-included -
# a bare !file inside an excluded dir is a no-op).
!plugins/
!plugins/auth-hermes-cloudflare/
plugins/auth-hermes-cloudflare/**
!plugins/auth-hermes-cloudflare/README.md
